// This config is in the KDL format: https://kdl.dev
// Full reference: https://niri-wm.github.io/niri/Configuration:-Introduction
//
// This file is hand-edited and symlinked in via home-manager
// (mkOutOfStoreSymlink), same as i3/rofi/kitty elsewhere in this repo --
// niri hot-reloads on save, so changes here are live immediately.
//
// Monitor mode/scale config is NOT here: it's generated by Nix per-host
// (see modules/stacks/desktop-niri in the nixos repo) and pulled in below,
// since it's genuinely host-specific hardware data, same as autorandr profiles.

// Per-output layout override for the U4025QW ultrawide (DP-1, ~4096 logical
// px wide @ scale 1.25). `proportion` widths scale with the monitor, so the
// laptop's "0.5" default becomes a ~2048px-wide column here -- too wide to
// be a useful single working column. `fixed` is monitor-width-independent,
// so it's the better default on a wide screen; proportion presets shift to
// quarters/thirds for when you actually want to fill/split the screen.
//
// This MUST come before the `include` below: niri merges flat properties
// (mode, scale, ...) across repeated `output "name" { ... }` blocks, but
// NOT nested blocks like `layout { ... }` -- only the first occurrence's
// nested block survives. Since outputs.kdl (included below) also declares
// `output "DP-1"` for mode/scale, this block has to be the first one seen,
// or its `layout` gets silently dropped.
//
// Hand-tuned here (rather than in outputs.kdl, which is Nix-generated) so
// the fixed-pixel value can be dialed in live via hot-reload. Once settled,
// it could move into modules/stacks/desktop-niri's outputConfig for
// zbornak, alongside the mode/scale for this same output -- as long as it
// stays ordered before whatever sets mode/scale for DP-1 there too.
output "DP-1" {
    layout {
        preset-column-widths {
            proportion 0.25
            proportion 0.33333
            proportion 0.5
            fixed 1100
        }

        default-column-width { fixed 1100; }
    }
}

include "/home/dave/.config/niri/outputs.kdl"

// Named workspaces for an i3-style "project" workflow: unlike niri's normal
// dynamic workspaces (which vanish when empty and get renumbered by
// position), these always exist and are addressed by name, so Mod+<key>
// below always lands on the same project regardless of what else is open.
workspace "ref"
workspace "dev"
workspace "email"

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock

        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
    }

    mouse {
    }
}

// No cursor theme was set, so niri fell back to its built-in default,
// which is missing some shape names (notably "pointer" -- the link-hover
// cursor). That left link hovers in Chromium-based apps (Wavebox) showing
// no cursor change at all, since the compositor renders the shape (via
// wp_cursor_shape_manager_v1) using its own theme, not the client's.
// Adwaita is already installed and has a proper "pointer" glyph.
cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

layout {
    gaps 0
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 1
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        width 1
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

// Startup programs. niri hot-reloads this file on save, so none of this
// needs a logout/login cycle to iterate on.
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "polkit-agent"
spawn-sh-at-startup "swaybg -i ~/.config/feh/background -m fill"

hotkey-overlay {
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Without this, focus-ring/border draw as a solid-color rectangle *behind*
// CSD windows (Zen, other GTK/Firefox-based apps) rather than around them,
// so they're invisible under an opaque window. Apps must be restarted to
// pick this up.
prefer-no-csd

animations {
}

// Some apps (Zen, other CSD apps that don't honor prefer-no-csd) never
// shrink to leave room for the border, so it just paints behind their
// opaque buffer and never shows. Force border-around-window everywhere.
window-rule {
    draw-border-with-background false
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Same "auto-float-terminal" convention as env/i3/config: `launch terminal
// --title auto-float-terminal` floats by title (bind below), matching
// whatever's running under that title rather than a specific app-id.
window-rule {
    match title="^auto-float-terminal$"
    open-floating true
    default-window-height { proportion 0.4; }
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open Term" { spawn "launch" "terminal"; }
    Mod+Ctrl+Return hotkey-overlay-title="Open Float Term" { spawn "launch" "terminal" "--title" "auto-float-terminal"; }
    Mod+Shift+Return hotkey-overlay-title="Open Term (stacked below)" { spawn "niri-stack-spawn" "--height" "25%" "launch" "terminal"; }
    Mod+Space hotkey-overlay-title="Run Application" { spawn "fuzzel"; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "swaylock"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay  allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop  allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev  allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext  allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Left  { focus-monitor-left; }
    Mod+Down  { focus-monitor-down; }
    Mod+Up    { focus-monitor-up; }
    Mod+Right { focus-monitor-right; }

    Mod+Shift+Left  { move-column-to-monitor-left; }
    Mod+Shift+Down  { move-column-to-monitor-down; }
    Mod+Shift+Up    { move-column-to-monitor-up; }
    Mod+Shift+Right { move-column-to-monitor-right; }

    Mod+U              { focus-workspace-up; }
    Mod+I              { focus-workspace-down; }

    Mod+G { focus-workspace "email"; }
    Mod+F { focus-workspace "dev"; }
    Mod+D { focus-workspace "ref"; }

    Mod+Shift+U         { move-column-to-workspace-up; }
    Mod+Shift+I         { move-column-to-workspace-down; }

    Mod+Ctrl+U         { move-workspace-up; }
    Mod+Ctrl+I         { move-workspace-down; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+Shift+F { maximize-column; }
    Mod+Semicolon { spawn "niri-fullscreen-toggle"; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    Mod+Shift+P { power-off-monitors; }

    Mod+N       hotkey-overlay-title="Dismiss Notification" { spawn "makoctl" "dismiss"; }
    Mod+Shift+N hotkey-overlay-title="Dismiss All Notifications" { spawn "makoctl" "dismiss" "-a"; }
}

// Zen (and similar Electron/Firefox apps) request focus via xdg-activation
// when a link is opened from another app (e.g. kitty, Wavebox), but the
// token's serial is usually invalid since zen itself isn't focused at the
// time. Niri drops those by default to stop apps stealing focus unprompted
// -- this flag opts back in, same tradeoff Discord/Telegram hit.
debug {
    honor-xdg-activation-with-invalid-serial
}
